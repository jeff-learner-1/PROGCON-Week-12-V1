<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Wk12D01Ex01_Tictactoe_game_version_1"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-30 03:20:20 AM"/>
        <attribute name="created" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0yODswOTo1NDo0OCBQTTsyNjk2"/>
        <attribute name="edited" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0zMDswMzoyMDoyMCBBTTsyOzI3NjA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="box1, box2, box3, currentPlayer" type="String" array="False" size=""/>
            <declare name="moveCount, chosenBox, startChoice" type="Integer" array="False" size=""/>
            <declare name="gameOver, validMove" type="Boolean" array="False" size=""/>
            <assign variable="box1" expression="&quot; &quot;"/>
            <assign variable="box2" expression="&quot; &quot;"/>
            <assign variable="box3" expression="&quot; &quot;"/>
            <assign variable="moveCount" expression="0"/>
            <assign variable="gameOver" expression="False"/>
            <assign variable="chosenBox" expression="0"/>
            <assign variable="startChoice" expression="Random(2) + 1"/>
            <if expression="startChoice == 1">
                <then>
                    <assign variable="currentPlayer" expression="&quot;O&quot;"/>
                    <output expression="&quot;Coin Toss: User (O) goes first!&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="currentPlayer" expression="&quot;X&quot;"/>
                    <output expression="&quot;Coin Toss: Computer (X) goes first!&quot;" newline="True"/>
                </else>
            </if>
            <while expression="gameOver == False AND moveCount &lt; 3">
                <output expression="&quot;[&quot; &amp; box1 &amp; &quot; | &quot; &amp; box2 &amp; &quot; | &quot; &amp; box3 &amp; &quot;]&quot;" newline="True"/>
                <if expression="currentPlayer == &quot;O&quot;">
                    <then>
                        <assign variable="validMove" expression="False"/>
                        <while expression="validMove == False">
                            <output expression="&quot;Enter box number (1, 2, or 3):&quot;" newline="True"/>
                            <input variable="chosenBox"/>
                            <if expression="chosenBox == 1 AND box1 == &quot; &quot;">
                                <then>
                                    <assign variable="box1" expression="&quot;X&quot;"/>
                                    <assign variable="validMove" expression="True"/>
                                </then>
                                <else>
                                    <if expression="chosenBox == 2 AND box2 == &quot; &quot;">
                                        <then>
                                            <assign variable="box2" expression="&quot;X&quot;"/>
                                            <assign variable="validMove" expression="True"/>
                                        </then>
                                        <else>
                                            <if expression="chosenBox == 3 AND box3 == &quot; &quot;">
                                                <then>
                                                    <assign variable="box3" expression="&quot;X&quot;"/>
                                                    <assign variable="validMove" expression="True"/>
                                                </then>
                                                <else>
                                                    <output expression="&quot;Invalid choice or box taken! Try again.&quot;" newline="True"/>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </while>
                    </then>
                    <else>
                        <assign variable="validMove" expression="False"/>
                        <while expression="validMove == False">
                            <assign variable="chosenBox" expression="Random(3) + 1"/>
                            <if expression="chosenBox == 1 AND box1 == &quot; &quot;">
                                <then>
                                    <assign variable="box1" expression="&quot;X&quot;"/>
                                    <assign variable="validMove" expression="True"/>
                                </then>
                                <else>
                                    <if expression="chosenBox == 2 AND box2 == &quot; &quot;">
                                        <then>
                                            <assign variable="box2" expression="&quot;X&quot;"/>
                                            <assign variable="validMove" expression="True"/>
                                        </then>
                                        <else>
                                            <if expression="chosenBox == 3 AND box3 == &quot; &quot;">
                                                <then>
                                                    <assign variable="box3" expression="&quot;X&quot;"/>
                                                    <assign variable="validMove" expression="True"/>
                                                </then>
                                                <else/>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </while>
                        <output expression="&quot;Computer played box &quot; &amp; chosenBox" newline="True"/>
                    </else>
                </if>
                <assign variable="moveCount" expression="moveCount + 1"/>
                <if expression="(box1 == box2) AND (box2 == box3) AND (box1 != &quot; &quot;)">
                    <then>
                        <output expression="&quot;FINAL BOARD: [&quot; &amp; box1 &amp; &quot; | &quot; &amp; box2 &amp; &quot; | &quot; &amp; box3 &amp; &quot;]&quot;" newline="True"/>
                        <output expression="&quot;GAME OVER! Computer wins!&quot;" newline="True"/>
                        <assign variable="gameOver" expression="True"/>
                    </then>
                    <else>
                        <if expression="moveCount == 3">
                            <then>
                                <output expression="&quot;FINAL BOARD: [&quot; &amp; box1 &amp; &quot; | &quot; &amp; box2 &amp; &quot; | &quot; &amp; box3 &amp; &quot;]&quot;" newline="True"/>
                                <output expression="&quot;GAME OVER! It is a draw!&quot;" newline="True"/>
                                <assign variable="gameOver" expression="True"/>
                            </then>
                            <else>
                                <if expression="currentPlayer == &quot;O&quot;">
                                    <then>
                                        <assign variable="currentPlayer" expression="&quot;X&quot;"/>
                                    </then>
                                    <else>
                                        <assign variable="currentPlayer" expression="&quot;O&quot;"/>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
